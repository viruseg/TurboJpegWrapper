<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>TurboJpeg.Wrapper.Native.win-x64</PackageId>
    <Description>TurboJPEG 3.2.1 native library for Windows x64, used by TurboJpeg.Wrapper.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\..\native\win-x64\turbojpeg.dll"
          Link="runtimes\win-x64\native\turbojpeg.dll"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="runtimes\win-x64\native\" />
    <None Include="..\..\..\native\THIRD-PARTY-NOTICES.md"
          Link="THIRD-PARTY-NOTICES.md"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>
</Project>
