<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <PackageId>TurboJpegWrapper</PackageId>
    <Version>1.0.0</Version>
    <Description>Production-oriented .NET wrapper for libjpeg-turbo TurboJPEG decoding to BMP.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\native\win-x64\turbojpeg.dll"
          Link="runtimes\win-x64\native\turbojpeg.dll"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="runtimes\win-x64\native\" />
    <None Include="..\..\native\THIRD-PARTY-NOTICES.md"
          Link="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="\" />
    <None Include="..\..\README.md"
          Link="README.md"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>
</Project>
